* text=auto
*.png binary
*.jpg binary
*.gif binary
*.otf binary
*.ttf binary
*.wav binary
*.svg text eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.godot text eol=lf
*.cs text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.ps1 text eol=crlf

# Serialized editor output contains empty YAML values with trailing spaces.
*.meta -whitespace
*.asset -whitespace
*.unity -whitespace
*.mat -whitespace
# Preserve upstream license/metadata formatting and Markdown line breaks.
assets/third_party/** -whitespace
assets/licenses/** -whitespace
**/LICENSE.txt -whitespace
*.md whitespace=-blank-at-eol,-blank-at-eof

# Large layered art sources use LFS; ordinary PNG/SVG remain regular Git files.
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text

# Preserve the embedded upstream Steamworks package formatting.
UnityProject/Packages/com.rlabrecque.steamworks.net/** -whitespace
*.dll binary
*.dylib binary
*.so binary
