<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="app" class="app">
        <ui:VisualElement name="menu-backdrop" class="menu-backdrop"><ui:VisualElement class="menu-shade" /></ui:VisualElement>

        <ui:VisualElement name="loading-page" class="loading-page">
            <ui:VisualElement name="loading-art" class="loading-art" />
            <ui:VisualElement class="loading-shade" />
            <ui:VisualElement class="loading-brand">
                <ui:Label text="SKILL SOCCER" class="loading-eyebrow" />
                <ui:Label text="技能足球" class="loading-title" />
                <ui:VisualElement class="loading-rule" />
            </ui:VisualElement>
            <ui:VisualElement class="loading-bottom">
                <ui:VisualElement class="row loading-caption"><ui:Label name="loading-status" text="正在准备赛场…" class="grow" /><ui:Label name="loading-percent" text="00%" /></ui:VisualElement>
                <ui:VisualElement class="loading-track"><ui:VisualElement name="loading-fill" class="loading-fill" /></ui:VisualElement>
                <ui:Label text="球场小提示：用传球和走位，为队友创造机会。" class="loading-tip" />
            </ui:VisualElement>
            <ui:Label text="0.25.0" class="loading-version" />
        </ui:VisualElement>


        <ui:VisualElement name="login-page" class="page login-page hidden">
            <ui:Label text="技能足球" class="eyebrow" />
            <ui:Label text="登录游戏" class="page-title" />
            <ui:Label text="离线也可局域网联机。" class="muted" />
            <ui:TextField name="login-name" label="帐号" />
            <ui:TextField name="login-password" label="密码" />
            <ui:Foldout text="试玩帐号" value="false" class="network-disclosure"><ui:Label text="a / a，b / b（帐号 / 密码）" class="muted" /></ui:Foldout>
            <ui:Label name="login-status" class="network-status" />
            <ui:VisualElement class="row login-actions"><ui:Button name="login-offline" text="离线进入" class="secondary" /><ui:Button name="login-submit" text="联网登录    →" class="primary" /></ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="home-page" class="game-home hidden">
            <ui:VisualElement class="home-topbar row"><ui:VisualElement class="grow" /><ui:Button name="home-friends" text="好友" class="home-account" /><ui:Label name="home-coins" class="home-coins" /><ui:Label name="connection-status" class="home-connection" /><ui:Button name="home-account" text="联网登录" class="home-account" /></ui:VisualElement>
            <ui:VisualElement class="home-body">
                <ui:VisualElement class="home-wordmark"><ui:Label text="SKILL SOCCER" class="home-brand-en" /><ui:Label text="技能足球" class="home-brand-title" /><ui:VisualElement class="home-brand-line" /></ui:VisualElement>
                <ui:VisualElement name="home-navigation" class="home-navigation">
                    <ui:Button name="bots-button" class="home-nav home-nav-primary"><ui:Label text="开始游戏" class="home-nav-title" /><ui:Label text="选择模式" class="home-nav-note" /><ui:Label text="›" class="home-nav-arrow" /></ui:Button>
                    <ui:Button name="normal-mode" text="联机对战" class="home-nav" />
                    <ui:Button name="train-button" text="训练场" class="home-nav" />
                    <ui:Button name="profile-button" text="个人主页" class="home-nav" />
                    <ui:Button name="shop-button" text="商城" class="home-nav" />
                    <ui:Button name="settings-button" text="设置" class="home-nav home-nav-small" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="home-bottom row"><ui:Label text="↑ ↓ 选择    Enter 确认" class="home-keyboard" /><ui:VisualElement class="grow" /><ui:Label text="0.25.0" class="home-version" /></ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="play-page" class="play-menu hidden">
            <ui:VisualElement class="row play-heading"><ui:Label text="选择模式" class="play-title grow" /><ui:Button name="play-back" text="‹ 返回" class="front-utility" /></ui:VisualElement>
            <ui:VisualElement class="play-options">
                <ui:Button name="play-online" class="play-option"><ui:Label text="普通对战" class="play-option-name" /><ui:Label text="互联网 / 局域网 · 3v3" class="play-option-note" /></ui:Button>
                <ui:Button name="play-ai" class="play-option"><ui:Label text="AI 对练" class="play-option-name" /><ui:Label text="本地 3v3" class="play-option-note" /></ui:Button>
                <ui:Button name="play-tutorial" class="play-option"><ui:Label text="新手教程" class="play-option-name" /><ui:Label text="操作与比赛机制" class="play-option-note" /></ui:Button>
                <ui:Button name="play-training" class="play-option"><ui:Label text="训练场" class="play-option-name" /><ui:Label text="自由练习" class="play-option-note" /></ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="mode-details-page" class="multiplayer-menu hidden">
            <ui:VisualElement class="multiplayer-topbar row"><ui:Button name="mode-back" text="‹  返回" class="front-utility" /><ui:VisualElement class="grow" /></ui:VisualElement>
            <ui:VisualElement class="multiplayer-body">
                <ui:Label text="联机对战" class="multiplayer-title" />
                <ui:VisualElement class="connection-panel">
                    <ui:VisualElement class="connection-tabs row"><ui:Button name="internet-route" text="互联网" class="route-button route-selected" /><ui:Button name="lan-route" text="局域网" class="route-button" /></ui:VisualElement>
                    <ui:VisualElement class="multiplayer-actions"><ui:Button name="online-play" text="创建房间" class="network-action" /><ui:Button name="join-room" text="加入房间" class="network-action" /></ui:VisualElement>
                    <ui:Label name="connection-copy" class="connection-copy hidden" />
                    <ui:Button name="route-login" text="联网登录" class="multiplayer-login hidden" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="network-page" class="page network-page network-setup hidden">
            <ui:VisualElement class="page-heading row">
                <ui:VisualElement class="grow"><ui:Label name="network-route" class="eyebrow" /><ui:Label name="network-title" text="创建房间" class="page-title" /></ui:VisualElement>
                <ui:Button name="network-back" text="返回" class="secondary" />
            </ui:VisualElement>
            <ui:VisualElement class="row network-tabs"><ui:Button name="network-create-tab" text="创建" class="route-button" /><ui:Button name="network-join-tab" text="加入" class="route-button" /></ui:VisualElement>
            <ui:ScrollView class="network-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement name="network-create-form" class="network-card">
                    <ui:TextField name="network-room-name" label="名称" value="足球房间" />
                    <ui:VisualElement name="network-internet-options">
                        <ui:Toggle name="network-password-enabled" label="设置密码" />
                        <ui:TextField name="network-room-password" label="密码" class="hidden" />
                    </ui:VisualElement>
                    <ui:Button name="network-create" text="创建房间" class="primary" />
                </ui:VisualElement>
                <ui:VisualElement name="network-join-form" class="network-card hidden">
                    <ui:TextField name="network-address" label="房间号" />
                    <ui:Label name="network-address-help" class="muted small" />
                    <ui:Foldout name="network-join-secret" text="需要密码？" value="false" class="network-disclosure">
                        <ui:TextField name="network-join-password" label="密码" />
                    </ui:Foldout>
                    <ui:Button name="network-join" text="加入房间" class="primary" />
                    <ui:VisualElement name="network-lan-discovery">
                        <ui:VisualElement class="row"><ui:Label text="附近房间" class="skill-heading grow" /><ui:Button name="network-refresh" text="刷新" class="secondary" /></ui:VisualElement>
                        <ui:Label name="network-room-list-empty" text="暂无房间" class="muted" />
                        <ui:VisualElement name="network-room-list" />
                        <ui:Foldout name="network-lan-help" text="找不到房间？" value="false" class="network-disclosure"><ui:Label text="也可以在上方输入房主 IP。" class="muted" /></ui:Foldout>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Foldout name="network-profile" text="玩家设置" value="false" class="network-disclosure">
                    <ui:TextField name="network-player-name" label="昵称" value="球员" />
                    <ui:DropdownField name="network-character" label="角色" class="hidden" />
                    <ui:DropdownField name="network-team" label="队伍" />
                </ui:Foldout>
            </ui:ScrollView>
            <ui:Label name="network-status" class="network-status hidden" />
        </ui:VisualElement>
        <ui:VisualElement name="room-page" class="page network-page network-lobby hidden">
            <ui:VisualElement class="page-heading row">
                <ui:VisualElement class="grow"><ui:Label name="lobby-route" class="eyebrow" /><ui:Label name="lobby-title" class="page-title" /><ui:Label name="lobby-summary" class="muted" /></ui:VisualElement>
                <ui:Button name="lobby-leave" text="离开" class="secondary" />
            </ui:VisualElement>
            <ui:VisualElement class="row lobby-invitation"><ui:TextField name="lobby-address" label="房间号" class="lobby-invite-field" /><ui:Button name="lobby-copy-address" text="复制" class="secondary" /></ui:VisualElement>
            <ui:ScrollView class="network-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement class="row network-teams">
                    <ui:VisualElement class="network-card grow"><ui:Label text="青队" class="skill-heading cyan" /><ui:VisualElement name="lobby-cyan-members" /></ui:VisualElement>
                    <ui:VisualElement class="network-card grow"><ui:Label text="橙队" class="skill-heading amber" /><ui:VisualElement name="lobby-amber-members" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:Foldout name="lobby-options" text="队伍" value="false" class="network-disclosure">
                    <ui:DropdownField name="lobby-character" label="角色" class="hidden" /><ui:DropdownField name="lobby-team" label="队伍" />
                    <ui:Label name="lobby-address-note" class="muted small" />
                </ui:Foldout>
            </ui:ScrollView>
            <ui:VisualElement class="row network-footer"><ui:Label name="lobby-status" class="network-status grow hidden" /><ui:VisualElement class="grow" /><ui:Button name="lobby-fill-bots" text="补齐机器人" class="secondary" /><ui:Button name="lobby-clear-bots" text="清空机器人" class="secondary" /><ui:Button name="lobby-ready" text="准备" class="primary" /></ui:VisualElement>
            <ui:VisualElement name="lobby-countdown" class="lobby-countdown hidden" picking-mode="Ignore"><ui:Label name="lobby-countdown-number" class="lobby-countdown-number" /><ui:Label text="即将进入选人布阵" class="lobby-countdown-copy" /><ui:Label text="取消准备可中止" class="social-muted" /></ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="select-page" class="selection hidden">
            <ui:VisualElement class="selection-heading row"><ui:VisualElement class="grow"><ui:Label name="select-title" text="选择角色" class="page-title" /><ui:Label name="select-subtitle" class="selection-subtitle" /></ui:VisualElement><ui:Button name="select-back" text="‹ 返回" class="front-utility" /></ui:VisualElement>
            <ui:VisualElement class="selection-content row">
                <ui:VisualElement class="roster-cards">
                    <ui:Button name="character-0" class="character-card selected"><ui:Label text="枪兵" class="card-name" /><ui:Label text="加速 / 炸弹" class="character-type" /></ui:Button>
                    <ui:Button name="character-1" class="character-card"><ui:Label text="雷神" class="card-name" /><ui:Label text="驱动 / 突进" class="character-type" /></ui:Button>
                    <ui:VisualElement name="draft-roster" class="draft-roster hidden"><ui:Label text="两队阵容" class="draft-section-label" /><ui:VisualElement name="draft-members" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="character-showcase">
                    <ui:VisualElement name="character-preview" class="character-preview" />
                    <ui:VisualElement class="preview-controls row"><ui:Label text="拖动环绕 · 滚轮缩放" class="preview-hint grow" /><ui:Button name="preview-auto" text="自动旋转：开" class="front-utility" /><ui:Button name="preview-reset" text="复位" class="front-utility" /></ui:VisualElement>
                    <ui:VisualElement name="draft-placement" class="draft-placement hidden"><ui:VisualElement class="row"><ui:Label name="draft-turn" class="draft-turn grow" /></ui:VisualElement><ui:VisualElement name="draft-map" class="draft-map" /><ui:Label name="draft-position-note" class="draft-position-note" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:ScrollView name="character-details" class="character-details" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                    <ui:Label name="selected-name" class="page-title" /><ui:Label name="selected-role" class="eyebrow" /><ui:Label name="selected-summary" class="selection-summary" />
                    <ui:VisualElement class="selection-ability row"><ui:VisualElement name="selection-weapon-art" class="selection-ability-art" /><ui:VisualElement class="grow"><ui:Label name="passive-name" class="skill-heading" /><ui:Label name="passive-copy" class="description" /></ui:VisualElement></ui:VisualElement>
                    <ui:VisualElement class="selection-ability row"><ui:VisualElement name="selection-q-art" class="selection-ability-art" /><ui:VisualElement class="grow"><ui:Label name="q-name" class="skill-heading" /><ui:Label name="q-copy" class="description" /></ui:VisualElement></ui:VisualElement>
                    <ui:VisualElement class="selection-ability row"><ui:VisualElement name="selection-e-art" class="selection-ability-art" /><ui:VisualElement class="grow"><ui:Label name="e-name" class="skill-heading" /><ui:Label name="e-copy" class="description" /></ui:VisualElement></ui:VisualElement>
                    <ui:Label name="selection-controls" class="selection-controls" />
                    <ui:Foldout name="character-parameters" text="查看技能参数" class="character-parameters" value="false"><ui:VisualElement name="character-parameter-content" class="hidden"><ui:Label name="selected-stats" class="stats-copy" /><ui:Label name="q-detail" class="parameter-copy" /><ui:Label name="e-detail" class="parameter-copy" /><ui:Label name="weapon-detail" class="parameter-copy" /></ui:VisualElement></ui:Foldout>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement class="selection-footer row"><ui:VisualElement class="grow" /><ui:Button name="start-button" text="开始训练" class="primary" /></ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="match-page" class="match-page hidden">
            <ui:VisualElement name="damage-vignette" class="damage-vignette" picking-mode="Ignore" />
            <ui:VisualElement class="hud-top row">
                <ui:VisualElement class="hud-left-slot">
                    <ui:Label name="mode-label" text="训练场" class="hud-pill" />
                    <ui:VisualElement name="compact-player-hud" class="compact-player-hud row hidden" picking-mode="Ignore">
                        <ui:VisualElement name="compact-portrait-frame" class="compact-portrait-frame"><ui:VisualElement name="compact-hero-symbol" class="hero-symbol" /></ui:VisualElement>
                        <ui:VisualElement class="compact-resources">
                            <ui:Label name="compact-health" text="生命 100 / 100" class="compact-health" />
                            <ui:Label name="compact-energy" text="能量 100 / 100" class="compact-energy" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="scoreboard row">
                    <ui:Label text="青队 ○" class="cyan team-name" /><ui:Label name="cyan-score" text="0" class="score cyan" />
                    <ui:Label name="clock-label" text="05:00" class="clock" />
                    <ui:Label name="amber-score" text="0" class="score amber" /><ui:Label text="◇ 橙队" class="amber team-name" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-actions row">
                    <ui:Button name="hud-mode-toggle" text="精简界面" class="hud-pill" />
                    <ui:Button name="pause-button" text="暂停  Esc" class="hud-pill" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="feedback-label" text="碰撞足球获得球权；推开角色腾出空间。" class="feedback" />
            <ui:Label name="ball-flight-status" class="ball-flight-status hidden" />
            <ui:Label name="phase-label" text="3" class="phase-label hidden" />
            <ui:VisualElement name="countdown-overlay" class="countdown-overlay hidden" picking-mode="Ignore">
                <ui:Label name="countdown-number" text="3" class="countdown-number" picking-mode="Ignore" />
                <ui:Label name="countdown-caption" text="准备开球" class="countdown-caption" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="tutorial-marker" class="tutorial-marker hidden" picking-mode="Ignore" />
            <ui:VisualElement name="tutorial-panel" class="tutorial-panel hidden">
                <ui:VisualElement class="row"><ui:Label name="tutorial-progress" class="tutorial-progress grow" /><ui:Button name="tutorial-exit" text="退出教程" class="tutorial-utility" /></ui:VisualElement>
                <ui:Label name="tutorial-title" class="tutorial-title" /><ui:Label name="tutorial-body" class="tutorial-body" />
                <ui:Label name="tutorial-objective" class="tutorial-objective" /><ui:Label name="tutorial-status" class="tutorial-status" />
                <ui:VisualElement class="row tutorial-actions"><ui:Button name="tutorial-previous" text="上一步" class="tutorial-utility" /><ui:Button name="tutorial-retry" text="重练" class="tutorial-utility" /><ui:Button name="tutorial-skip" text="跳过" class="tutorial-utility" /><ui:Button name="tutorial-next" text="下一步" class="tutorial-next" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="training-tools" class="training-tools">
                <ui:Label text="训练工具" class="skill-heading" />
                <ui:Button name="reset-ball" text="R  重置球场" />
                <ui:Button name="give-ball" text="F  自己持球" />
                <ui:Button name="target-ball" text="T  目标持球" />
                <ui:Button name="moving-target" text="目标：静止" />
                <ui:Button name="training-corner" text="F2  角球" />
                <ui:Button name="training-free-kick" text="F3  任意球" />
                <ui:Button name="debug-toggle" text="F1  判定显示：开" />
                <ui:Button name="end-training" text="结束训练" class="secondary" />
            </ui:VisualElement>
            <ui:Label name="combat-toast" class="combat-toast" picking-mode="Ignore" />
            <ui:VisualElement name="battle-dock-anchor" class="hud-bottom-anchor" picking-mode="Ignore">
            <ui:VisualElement name="battle-dock" class="hud-bottom row">
                <ui:VisualElement name="dock-backdrop" class="dock-backdrop" picking-mode="Ignore" />
                <ui:VisualElement class="hero-summary">
                    <ui:VisualElement name="hero-portrait-frame" class="hero-portrait-frame"><ui:VisualElement name="hero-symbol" class="hero-symbol" /></ui:VisualElement>
                    <ui:Label name="local-name" text="枪兵 · 你" class="hero-name" />
                    <ui:Label name="possession-label" text="无球" class="hero-state" />
                </ui:VisualElement>
                <ui:VisualElement name="hud-main" class="hud-main">
                    <ui:VisualElement class="hud-stat-strip row"><ui:Label text="技能与行动" class="dock-heading" /><ui:Label name="hud-stats" /><ui:Label name="bomb-action" class="bomb-action hidden" /></ui:VisualElement>
                    <ui:VisualElement name="ability-strip" class="ability-strip row">
                        <ui:VisualElement name="q-tile" class="skill-tile">
                            <ui:VisualElement class="ability-frame">
                                <ui:VisualElement name="q-symbol" class="skill-symbol" />
                                <ui:VisualElement name="q-mask" class="cooldown-mask" />
                                <ui:Label name="q-cd" class="cooldown-number" />
                                <ui:Label text="Q" class="ability-key" />
                            </ui:VisualElement>
                            <ui:Label name="hud-q-name" text="兴奋剂" class="ability-caption" />
                            <ui:Label name="q-cost" text="12能 / 10血" class="ability-cost" />
                        </ui:VisualElement>
                        <ui:VisualElement name="e-tile" class="skill-tile">
                            <ui:VisualElement class="ability-frame">
                                <ui:VisualElement name="e-symbol" class="skill-symbol" />
                                <ui:VisualElement name="e-mask" class="cooldown-mask" />
                                <ui:Label name="e-cd" class="cooldown-number" />
                                <ui:Label text="E" class="ability-key" />
                            </ui:VisualElement>
                            <ui:Label name="hud-e-name" text="炸弹" class="ability-caption" />
                            <ui:Label name="e-cost" text="40能" class="ability-cost" />
                        </ui:VisualElement>
                        <ui:VisualElement name="g-tile" class="skill-tile">
                            <ui:VisualElement class="ability-frame">
                                <ui:VisualElement name="g-symbol" class="skill-symbol" />
                                <ui:VisualElement name="g-mask" class="cooldown-mask" />
                                <ui:Label name="g-cd" class="cooldown-number" />
                                <ui:Label text="G" class="ability-key" />
                            </ui:VisualElement>
                            <ui:Label text="引爆" class="ability-caption" />
                            <ui:Label name="g-cost" text="10能" class="ability-cost" />
                        </ui:VisualElement>
                        <ui:VisualElement class="ability-divider" />
                        <ui:VisualElement name="kick-tile" class="skill-tile">
                            <ui:VisualElement class="ability-frame">
                                <ui:VisualElement name="kick-symbol" class="skill-symbol" />
                                <ui:VisualElement name="kick-mask" class="cooldown-mask" />
                                <ui:Label name="kick-cd" class="cooldown-number" />
                                <ui:Label text="V" class="ability-key" />
                            </ui:VisualElement>
                            <ui:Label text="踢球" class="ability-caption" />
                            <ui:Label name="kick-cost" text="冷却 6秒" class="ability-cost" />
                        </ui:VisualElement>
                        <ui:VisualElement name="tackle-tile" class="skill-tile">
                            <ui:VisualElement class="ability-frame">
                                <ui:VisualElement name="tackle-symbol" class="skill-symbol" />
                                <ui:VisualElement name="tackle-mask" class="cooldown-mask" />
                                <ui:Label name="tackle-cd" class="cooldown-number" />
                                <ui:Label text="空格" class="ability-key" />
                            </ui:VisualElement>
                            <ui:Label text="铲球" class="ability-caption" />
                            <ui:Label name="tackle-cost" text="16.1生命" class="ability-cost" />
                        </ui:VisualElement>
                        <ui:VisualElement name="weapon-tile" class="skill-tile">
                            <ui:VisualElement class="ability-frame">
                                <ui:VisualElement name="weapon-symbol" class="skill-symbol" />
                                <ui:VisualElement name="weapon-mask" class="cooldown-mask" />
                                <ui:Label name="weapon-reload-cd" class="cooldown-number" />
                                <ui:Label text="右键" class="ability-key" />
                            </ui:VisualElement>
                            <ui:Label text="普攻" class="ability-caption" />
                            <ui:Label name="weapon-cd" text="右键追击" class="ability-cost" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="resource-deck">
                    <ui:Label name="energy-delta" class="resource-delta energy-delta" picking-mode="Ignore" />
                    <ui:ProgressBar name="health-progress" title="生命 100/100" low-value="0" high-value="100" value="100" class="resource-progress health-progress" />
                    <ui:ProgressBar name="energy-progress" title="能量 100/100" low-value="0" high-value="100" value="100" class="resource-progress energy-progress" />
                    </ui:VisualElement>
                    <ui:ProgressBar name="charge-progress" title="蓄力" low-value="0" high-value="100" class="charge-progress hidden" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-help">
                    <ui:Label text="W A S D" class="hud-help-title" />
                    <ui:Label text="移动／追击 · S 停止" />
                    <ui:Label text="按住 V 蓄力" />
                    <ui:Label text="松开出球 · C取消" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        </ui:VisualElement>
        <ui:VisualElement name="pause-overlay" class="overlay hidden">
            <ui:VisualElement class="modal">
                <ui:Label name="pause-title" text="比赛已暂停" class="page-title" />
                <ui:Label name="pause-copy" text="准备好了，就继续回到球场。" class="muted" />
                <ui:Button name="resume-button" text="继续比赛" class="primary" />
                <ui:Button name="restart-button" text="重新开始" />
                <ui:Button name="pause-home" text="返回主菜单" class="secondary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="results-page" class="page results hidden">
            <ui:Label text="MATCH REPORT" class="eyebrow" />
            <ui:Label name="result-title" text="训练完成" class="page-title" />
            <ui:Label name="result-score" text="0 : 0" class="result-score" />
            <ui:Label name="result-subtitle" class="muted" />
            <ui:VisualElement class="row result-wallet"><ui:Label name="result-reward" class="result-reward grow" /><ui:Label name="result-coins" class="result-coins" /></ui:VisualElement>
            <ui:Label name="combat-summary" class="muted combat-summary" />
            <ui:VisualElement class="result-stats row">
                <ui:VisualElement class="stat"><ui:Label name="stat-goals" class="stat-number" /><ui:Label text="进球" /></ui:VisualElement>
                <ui:VisualElement class="stat"><ui:Label name="stat-steals" class="stat-number" /><ui:Label text="碰撞夺球" /></ui:VisualElement>
                <ui:VisualElement class="stat"><ui:Label name="stat-kicks" class="stat-number" /><ui:Label text="踢球" /></ui:VisualElement>
                <ui:VisualElement class="stat"><ui:Label name="stat-passes" class="stat-number" /><ui:Label text="成功传球" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="row"><ui:Button name="play-again" text="再来一局    →" class="primary" /><ui:Button name="results-history" text="对局记录" class="secondary" /><ui:Button name="results-home" text="返回主菜单" class="secondary" /></ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="history-page" class="history-page hidden">
            <ui:VisualElement class="row history-heading"><ui:VisualElement class="grow"><ui:Label text="对局记录" class="history-title" /><ui:Label name="history-profile" class="history-profile" /></ui:VisualElement><ui:Button name="history-back" text="‹ 返回" class="front-utility" /></ui:VisualElement>
            <ui:Label name="history-status" class="history-status" />
            <ui:VisualElement name="history-empty" class="history-empty"><ui:Label text="暂无对局记录" class="history-empty-title" /><ui:Label text="完成一场正式对局后，赛果会保存到这里。" class="history-profile" /></ui:VisualElement>
            <ui:VisualElement class="row history-content"><ui:ScrollView name="history-list" class="history-list" mode="Vertical" horizontal-scroller-visibility="Hidden" />
                <ui:VisualElement name="history-detail" class="history-detail"><ui:Label name="history-detail-title" class="history-detail-title" /><ui:Label name="history-detail-meta" class="history-detail-meta" /><ui:Label name="history-detail-stats" class="history-detail-stats" /><ui:Label name="history-detail-coins" class="history-detail-coins" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="profile-page" class="social-page hidden">
            <ui:VisualElement class="row social-heading"><ui:VisualElement class="grow"><ui:Label name="profile-name" class="social-title" /><ui:Label name="profile-id" class="social-muted" /></ui:VisualElement><ui:Button name="profile-friends" text="好友" class="front-utility" /><ui:Button name="profile-back" text="‹ 返回" class="front-utility" /></ui:VisualElement>
            <ui:Label name="profile-status" class="social-status" />
            <ui:VisualElement class="row profile-metrics"><ui:VisualElement class="profile-metric"><ui:Label name="profile-matches" class="profile-number" /><ui:Label text="累计场次" class="social-muted" /></ui:VisualElement><ui:VisualElement class="profile-metric"><ui:Label name="profile-winrate" class="profile-number" /><ui:Label text="胜率" class="social-muted" /></ui:VisualElement><ui:VisualElement class="profile-metric"><ui:Label name="profile-goals" class="profile-number" /><ui:Label text="总进球" class="social-muted" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement name="profile-heroes" class="row profile-heroes" />
            <ui:VisualElement class="row profile-recent-heading"><ui:Label name="profile-recent-title" text="最近战绩" class="social-section grow" /><ui:Button name="profile-all" text="全部角色" class="social-action" /><ui:Button name="profile-history" text="战绩详情" class="social-action" /></ui:VisualElement>
            <ui:Label name="profile-empty" text="暂无战绩，完成正式对局后会显示在这里。" class="social-muted" /><ui:ScrollView name="profile-recent" class="profile-recent" mode="Vertical" horizontal-scroller-visibility="Hidden" />
        </ui:VisualElement>
        <ui:VisualElement name="friends-page" class="social-page hidden">
            <ui:VisualElement class="row social-heading"><ui:Label text="好友" class="social-title grow" /><ui:Button name="friends-refresh" text="刷新" class="front-utility" /><ui:Button name="friends-back" text="‹ 返回" class="front-utility" /></ui:VisualElement>
            <ui:VisualElement name="friends-offline" class="social-offline"><ui:Label text="联网登录后可添加好友" class="social-section" /><ui:Button name="friends-login" text="联网登录" class="primary" /></ui:VisualElement>
            <ui:VisualElement name="friends-online" class="friends-online"><ui:VisualElement class="row friend-search-row"><ui:TextField name="friend-account" label="帐号 ID" class="grow" /><ui:Button name="friend-search" text="查找玩家" class="social-action" /></ui:VisualElement><ui:Label name="friends-status" class="social-status" /><ui:VisualElement name="friend-result" />
                <ui:VisualElement class="row friends-columns"><ui:VisualElement class="friends-column"><ui:Label name="friends-count" text="好友 · 0" class="social-section" /><ui:Label name="friends-empty" text="暂无好友，可以通过帐号 ID 添加。" class="social-muted" /><ui:ScrollView name="friends-list" mode="Vertical" horizontal-scroller-visibility="Hidden" class="friends-list" /></ui:VisualElement><ui:VisualElement class="friends-column"><ui:Label name="friends-requests-title" text="申请 · 0" class="social-section" /><ui:ScrollView name="friends-requests" mode="Vertical" horizontal-scroller-visibility="Hidden" class="friends-list" /></ui:VisualElement></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="shop-page" class="shop-page hidden">
            <ui:VisualElement class="row shop-heading"><ui:Label text="商城" class="shop-title grow" /><ui:Button name="shop-back" text="‹ 返回" class="front-utility" /></ui:VisualElement>
            <ui:VisualElement class="shop-content">
                <ui:VisualElement class="row shop-wallet"><ui:VisualElement class="grow"><ui:Label name="shop-profile" class="shop-profile" /><ui:Label text="金币" class="shop-currency" /><ui:Label name="shop-coins" class="shop-balance" /></ui:VisualElement><ui:VisualElement class="shop-earning"><ui:Label text="对战胜利" class="shop-earning-title" /><ui:Label text="+100 金币" class="shop-earning-amount" /><ui:Label text="AI 对练 / 局域网 / 互联网" class="shop-note" /></ui:VisualElement></ui:VisualElement>
                <ui:Label name="shop-status" class="shop-note shop-status" />
                <ui:VisualElement class="row shop-tabs"><ui:Button name="shop-heroes-tab" text="英雄" class="shop-tab shop-tab-selected" /><ui:Button name="shop-skins-tab" text="皮肤" class="shop-tab" /></ui:VisualElement>
                <ui:VisualElement name="shop-heroes"><ui:VisualElement class="row shop-items">
                    <ui:VisualElement class="shop-item"><ui:VisualElement name="shop-marine-art" class="shop-portrait" /><ui:Label text="枪兵" class="shop-item-name" /><ui:Label text="初始英雄 · 已拥有" class="shop-owned" /></ui:VisualElement>
                    <ui:VisualElement class="shop-item"><ui:VisualElement name="shop-thor-art" class="shop-portrait" /><ui:Label text="雷神" class="shop-item-name" /><ui:Label text="初始英雄 · 已拥有" class="shop-owned" /></ui:VisualElement>
                </ui:VisualElement><ui:Label text="后续英雄将在这里开放购买" class="shop-note shop-coming" /></ui:VisualElement>
                <ui:VisualElement name="shop-skins" class="shop-empty hidden"><ui:Label text="皮肤即将上线" class="shop-empty-title" /><ui:Label text="后续可用金币购买角色皮肤" class="shop-note" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="settings-page" class="page settings hidden">
            <ui:VisualElement class="row settings-heading"><ui:Label text="设置" class="page-title grow" /><ui:Button name="settings-back" text="‹ 返回主菜单" class="secondary" /></ui:VisualElement>
            <ui:VisualElement class="row settings-tabs"><ui:Button name="settings-general-tab" text="通用" class="settings-tab settings-tab-selected" /><ui:Button name="settings-keys-tab" text="按键" class="settings-tab" /></ui:VisualElement>
            <ui:VisualElement name="settings-general" class="settings-general">
                <ui:Slider name="volume-slider" label="总音量" low-value="0" high-value="1" value="0.6" />
                <ui:Slider name="music-slider" label="背景音乐" low-value="0" high-value="1" value="0.55" />
                <ui:Slider name="effects-slider" label="音效" low-value="0" high-value="1" value="0.8" />
                <ui:VisualElement class="settings-toggles"><ui:Button name="mute-toggle" text="静音：关" class="secondary" /><ui:Button name="feedback-toggle" text="命中反馈：开" class="secondary" /><ui:Button name="hud-mode-setting" text="完整技能栏：开" class="secondary" /></ui:VisualElement>
                <ui:Label text="关闭完整技能栏后显示简洁的头像、生命与能量。" class="muted hud-setting-copy" />
            </ui:VisualElement>
            <ui:VisualElement name="settings-keys" class="settings-keys hidden">
                <ui:VisualElement class="row keys-heading"><ui:Label text="点击按键后修改 · 自动保存" class="muted grow" /><ui:Button name="keys-reset" text="恢复默认" class="secondary" /></ui:VisualElement>
                <ui:ScrollView name="keys-scroll" class="keys-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden"><ui:VisualElement name="keybinding-list" /><ui:Label text="鼠标右键：移动 / 追击&#10;鼠标左键：确认技能目标&#10;Esc：始终可以返回或打开比赛菜单" class="fixed-mouse-keys" /></ui:ScrollView>
                <ui:Label name="keys-status" text="" class="keys-status" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
