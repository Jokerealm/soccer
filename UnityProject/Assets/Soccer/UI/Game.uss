/* HD UI v3: real CJK weights, restrained surfaces, sharp vector symbols. */
.app { flex-grow: 1; color: rgb(247,247,238); -unity-font-definition: url("ChineseFont.asset"); font-size: 18px; }
.hidden { display: none; }
.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; }
Label { margin: 0; padding: 0; }
.menu-backdrop, .loading-art { position: absolute; top: 0; bottom: 0; left: 0; right: 0; -unity-background-scale-mode: scale-and-crop; background-color: rgb(15,31,53); }
.menu-shade { flex-grow: 1; background-color: rgba(8,21,39,0.25); }
Button { color: rgb(30,48,62); background-color: rgb(238,242,234); border-color: rgb(186,200,196); border-width: 1px; border-bottom-width: 4px; border-bottom-color: rgb(136,157,161); border-radius: 12px; padding: 11px 20px; margin: 6px 8px 6px 0; min-height: 48px; font-size: 17px; transition-property: background-color, border-color; transition-duration: 0.12s; }
Button:hover { background-color: rgb(255,255,249); border-color: rgb(89,181,171); border-bottom-color: rgb(60,137,143); }
Button:active { background-color: rgb(207,225,219); border-bottom-width: 2px; padding-top: 13px; }
Button:focus { border-top-color: rgb(247,191,87); border-left-color: rgb(247,191,87); border-right-color: rgb(247,191,87); }
Button.primary { background-color: rgb(247,196,91); border-color: rgb(255,225,155); border-bottom-color: rgb(171,118,46); -unity-font-definition: url("ChineseBold.asset"); font-size: 20px; }
Button.primary:hover { background-color: rgb(255,214,116); }
Button.secondary { background-color: rgb(222,232,227); }
Button:disabled { color: rgb(127,143,151); background-color: rgb(214,223,222); border-color: rgb(198,211,209); }
.eyebrow, .front-brand-sub { color: rgb(158,222,216); font-size: 12px; letter-spacing: 2px; margin-bottom: 8px; }
.muted { color: rgb(107,130,140); white-space: normal; font-size: 16px; }
.small { font-size: 13px; }
.page-title, .mode-page-title, .front-brand, .loading-title, .mode-card-title, .detail-title, .card-name, .stat-number, .score { -unity-font-definition: url("ChineseBold.asset"); }
.page-title { font-size: 38px; margin-bottom: 10px; }
.page { flex-grow: 1; margin: 40px 64px; padding: 32px; background-color: rgb(245,246,237); color: rgb(30,48,62); border-radius: 22px; border-width: 1px; border-color: rgb(255,255,249); border-bottom-width: 7px; border-bottom-color: rgb(139,160,166); }
.page .eyebrow { color: rgb(32,133,131); }
.page .skill-heading { color: rgb(37,108,112); }
.page-heading { margin-bottom: 20px; }
/* Main menu: a live arena with a single vertical navigation rail. */
.game-home { flex-grow: 1; padding: 28px 58px 22px; }
.home-topbar { height: 44px; flex-shrink: 0; }
.home-connection { color: rgb(188,203,214); font-size: 13px; margin-right: 18px; }
Button.home-account { min-height: 38px; margin: 0; padding: 7px 18px; border-radius: 2px; border-width: 1px; border-color: rgba(184,205,214,0.4); color: rgb(229,237,242); background-color: rgba(8,19,29,0.65); }
Button.home-account:hover { background-color: rgb(43,68,78); border-color: rgb(216,232,237); }
.home-body { flex-grow: 1; justify-content: center; padding-bottom: 12px; }
.home-wordmark { margin-bottom: 42px; }
.home-brand-en { font-size: 13px; letter-spacing: 5px; color: rgb(171,192,206); margin-bottom: 7px; }
.home-brand-title { font-size: 68px; letter-spacing: 4px; -unity-font-definition: url("ChineseBold.asset"); color: rgb(242,245,245); }
.home-brand-line { width: 54px; height: 3px; margin-top: 18px; background-color: rgb(255,183,70); }
.home-navigation { width: 340px; max-width: 43%; }
Button.home-nav { width: 100%; min-height: 61px; flex-shrink: 0; margin: 0 0 7px; padding: 9px 20px; border-width: 0; border-left-width: 3px; border-left-color: rgba(255,183,70,0); border-radius: 0; color: rgb(214,225,232); background-color: rgba(10,23,35,0.18); font-size: 28px; -unity-font-definition: url("ChineseBold.asset"); -unity-text-align: middle-left; }
Button.home-nav:hover, Button.home-nav:focus { border-left-color: rgb(255,183,70); background-color: rgba(119,153,171,0.17); color: rgb(255,244,223); }
Button.home-nav:active { padding-top: 9px; background-color: rgba(174,189,196,0.22); }
Button.home-nav-primary { min-height: 85px; padding-top: 13px; padding-bottom: 13px; margin-bottom: 12px; background-color: rgba(169,124,54,0.18); border-left-color: rgb(255,183,70); }
.home-nav-title { font-size: 34px; color: rgb(255,202,111); -unity-text-align: middle-left; }
.home-nav-note { font-size: 12px; color: rgb(186,194,193); margin-top: 3px; -unity-font-definition: url("ChineseFont.asset"); }
.home-nav-arrow { position: absolute; right: 18px; top: 15px; font-size: 40px; color: rgb(255,202,111); }
Button.home-nav-small { font-size: 22px; min-height: 51px; margin-top: 10px; }
.home-bottom { height: 34px; flex-shrink: 0; border-top-width: 1px; border-top-color: rgba(152,179,193,0.17); padding-top: 14px; }
.home-keyboard, .home-version { font-size: 11px; color: rgb(151,169,184); }
Button.front-utility { background-color: rgba(10,23,35,0.7); color: rgb(229,238,242); border-color: rgba(189,219,218,0.25); border-width: 1px; font-size: 15px; min-height: 38px; padding: 8px 17px; border-radius: 2px; margin-right: 10px; }
Button.front-utility:hover { background-color: rgb(46,76,86); }
/* Launch */
.loading-page { flex-grow: 1; background-color: rgb(12,28,48); }
.loading-shade { position: absolute; top: 0; bottom: 0; left: 0; width: 44%; background-color: rgba(9,28,50,0.26); }
.loading-brand { position: absolute; top: 28%; left: 7%; }
.loading-eyebrow { font-size: 14px; letter-spacing: 3px; color: rgb(152,225,214); margin-bottom: 18px; }
.loading-title { font-size: 96px; color: rgb(255,248,221); }
.loading-tagline { font-size: 27px; color: rgb(216,233,229); margin-top: 15px; }
.loading-rule { width: 70px; height: 4px; margin-top: 28px; margin-bottom: 20px; background-color: rgb(247,196,91); border-radius: 2px; }
.loading-motto { font-size: 12px; letter-spacing: 2px; color: rgb(144,184,200); }
.loading-bottom { position: absolute; left: 7%; bottom: 10%; width: 34%; }
.loading-caption { font-size: 14px; margin-bottom: 14px; }
.loading-track { height: 8px; background-color: rgba(108,151,173,0.35); border-radius: 4px; overflow: hidden; }
.loading-fill { height: 8px; width: 0; background-color: rgb(247,196,91); border-radius: 4px; }
.loading-tip { font-size: 13px; margin-top: 16px; color: rgb(171,201,210); white-space: normal; }
.loading-version { position: absolute; right: 32px; bottom: 24px; font-size: 12px; color: rgb(161,183,198); }
/* Multiplayer entry exposes connection choice and two actions. */
.multiplayer-menu { flex-grow: 1; padding: 30px 58px; }
.multiplayer-topbar { height: 44px; flex-shrink: 0; }
.multiplayer-body { flex-grow: 1; justify-content: center; width: 460px; max-width: 48%; padding-bottom: 35px; }
.multiplayer-title { font-size: 44px; color: rgb(242,245,245); -unity-font-definition: url("ChineseBold.asset"); margin-bottom: 28px; }
.connection-panel { padding: 0; }
.connection-tabs { padding: 3px; border-width: 1px; border-color: rgba(155,185,203,0.3); background-color: rgba(8,18,29,0.8); margin-bottom: 22px; }
Button.route-button { flex-grow: 1; flex-basis: 0; min-height: 42px; font-size: 17px; margin: 0; padding: 8px; border-width: 0; background-color: rgba(0,0,0,0); }
.connection-panel Button.route-button { color: rgb(174,195,209); border-radius: 0; }
.connection-panel Button.route-button.route-selected { background-color: rgb(48,72,86); color: rgb(255,208,130); }
.connection-panel Button.route-button:hover { background-color: rgb(41,60,76); }
.connection-panel Button.route-button:disabled { background-color: rgba(8,18,29,0); color: rgb(93,115,132); }
.connection-panel Button.network-action { min-height: 66px; margin: 0 0 12px; padding: 15px 22px; color: rgb(237,243,244); background-color: rgba(23,44,61,0.87); border-width: 1px; border-color: rgba(159,188,202,0.25); border-left-width: 3px; border-radius: 0; font-size: 25px; -unity-font-definition: url("ChineseBold.asset"); -unity-text-align: middle-left; }
.connection-panel Button.network-action:hover, .connection-panel Button.network-action:focus { border-left-color: rgb(255,183,70); background-color: rgba(60,83,101,0.94); }
.connection-copy { font-size: 13px; color: rgb(160,181,197); margin-top: 11px; white-space: normal; }
Button.multiplayer-login { align-self: flex-start; background-color: rgba(0,0,0,0); color: rgb(255,203,116); border-width: 0; border-radius: 0; padding: 5px 0; margin: 5px 0 0; min-height: 30px; font-size: 14px; }
/* Character selection displays the actual playable model in a dedicated orbit viewport. */
.selection { flex-grow: 1; margin: 28px 58px; }
.selection-heading { margin-bottom: 22px; flex-shrink: 0; }
.selection .page-title { color: rgb(233,242,245); font-size: 34px; }
.selection-subtitle { color: rgb(158,182,197); font-size: 13px; }
.selection-content { flex-grow: 1; flex-basis: 0; min-height: 0; align-items: stretch; }
.roster-cards { width: 176px; flex-shrink: 0; margin-right: 20px; }
Button.character-card { min-height: 105px; margin: 0 0 12px; padding: 18px; background-color: rgba(18,36,50,0.92); border-width: 1px; border-color: rgba(152,177,193,0.25); border-left-width: 3px; border-radius: 0; color: rgb(205,220,230); align-items: flex-start; }
Button.character-card.selected { background-color: rgb(37,62,79); border-left-color: rgb(255,193,89); }
Button.character-card:hover { background-color: rgb(46,73,91); }
.card-name { font-size: 26px; margin: 0 0 9px; color: rgb(242,245,245); }
.character-type { font-size: 13px; color: rgb(157,186,203); }
.character-showcase { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 24px; }
.character-preview { flex-grow: 1; min-height: 180px; background-color: rgb(9,17,23); border-width: 1px; border-color: rgba(152,183,200,0.23); -unity-background-scale-mode: scale-to-fit; }
.preview-controls { flex-wrap: wrap; margin-top: 9px; }
.preview-hint { font-size: 12px; color: rgb(160,181,194); margin-right: 10px; }
.preview-controls Button { font-size: 12px; padding: 6px 10px; min-height: 30px; }
.character-details { width: 324px; flex-shrink: 0; min-height: 0; padding: 18px; border-left-width: 1px; border-left-color: rgba(135,166,185,0.22); background-color: rgba(9,21,32,0.8); }
.selection .character-details .page-title { font-size: 28px; margin-bottom: 7px; }
.selection .character-details .eyebrow { color: rgb(113,204,209); font-size: 13px; margin-bottom: 16px; }
.stats-copy { color: rgb(234,193,122); font-size: 14px; margin-bottom: 18px; white-space: normal; }
.skill-heading { -unity-font-definition: url("ChineseBold.asset"); color: rgb(50,118,119); font-size: 16px; margin: 7px 0; }
.description { white-space: normal; font-size: 17px; margin-bottom: 10px; }
.selection .skill-heading { color: rgb(158,218,219); font-size: 15px; }
.selection .description { color: rgb(175,196,209); font-size: 14px; margin-bottom: 19px; }
.selection-footer { margin-top: 12px; flex-shrink: 0; }
.narrow-front-end .selection { margin-left: 38px; margin-right: 38px; }
.narrow-front-end .roster-cards { width: 150px; margin-right: 16px; }
.narrow-front-end .character-details { width: 292px; padding: 15px; }
.narrow-front-end .character-showcase { margin-right: 16px; }
.character-details .unity-scroller--vertical { width: 7px; margin-left: 7px; }
.character-details .unity-scroller__low-button, .character-details .unity-scroller__high-button { display: none; }
.character-details .unity-slider__tracker { background-color: rgb(215,227,220); }
.character-details .unity-slider__dragger { background-color: rgb(104,171,161); border-radius: 4px; border-width: 0; }
.character-details .unity-base-slider__tracker { background-color: rgb(215,227,220); }
.character-details .unity-base-slider__dragger { background-color: rgb(104,171,161); background-image: none; border-radius: 4px; border-width: 0; }
/* In-game UI: compact safe margins, no large translucent slab. */
.match-page { flex-grow: 1; }
.hud-top { position: absolute; top: 14px; left: 22px; right: 22px; justify-content: space-between; }
.hud-left-slot, .hud-actions { width: 236px; flex-shrink: 0; }
.hud-left-slot { align-items: flex-start; }
.hud-actions { justify-content: flex-end; }
.hud-actions Button { margin: 0 0 0 8px; padding: 9px 12px; font-size: 13px; }
.compact-player-hud { height: 62px; width: 236px; padding: 5px 10px 5px 5px; background-color: rgba(9,29,36,0.60); border-width: 1px; border-color: rgba(157,197,177,0.38); border-radius: 12px; }
.compact-portrait-frame { width: 50px; height: 50px; flex-shrink: 0; border-width: 2px; border-color: rgb(143,188,167); border-radius: 26px; overflow: hidden; background-color: rgb(5,19,26); }
.compact-portrait-frame .hero-symbol { border-radius: 22px; }
.compact-resources { margin-left: 11px; }
.compact-resources Label { font-size: 14px; -unity-font-definition: url("ChineseBold.asset"); text-shadow: 0 1px 2px rgba(0,0,0,0.95); }
.compact-health { color: rgb(115,229,171); margin-bottom: 5px; }
.compact-health.low-health { color: rgb(255,139,107); }
.compact-energy { color: rgb(140,204,250); }
.hud-pill { color: rgb(242,248,235); background-color: rgb(17,43,49); border-width: 1px; border-color: rgb(88,123,116); border-bottom-color: rgb(8,24,38); border-bottom-width: 3px; border-radius: 10px; padding: 9px 15px; min-height: 40px; font-size: 14px; }
.scoreboard { height: 62px; padding: 6px 20px; background-image: url("../Resources/FrontEnd/ui-dock-v2.png"); background-color: transparent; border-radius: 12px; border-width: 0; border-color: rgb(120,151,162); border-bottom-width: 4px; border-bottom-color: rgb(9,26,41); }
.score { font-size: 34px; margin: 0 16px; }
.clock { min-width: 80px; -unity-text-align: middle-center; font-size: 21px; margin: 0 12px; padding: 8px 10px; background-color: rgb(11,30,47); border-radius: 7px; color: rgb(253,246,220); }
.team-name { font-size: 12px; }
.cyan { color: rgb(103,224,198); }
.amber { color: rgb(252,201,106); }
.feedback { position: absolute; top: 141px; align-self: center; padding: 5px 13px; background-color: rgba(12,36,41,0.9); border-radius: 7px; color: rgb(223,239,228); font-size: 13px; }
.ball-flight-status { position: absolute; top: 177px; align-self: center; padding: 5px 13px; background-color: rgb(251,216,130); border-radius: 7px; color: rgb(34,61,68); font-size: 13px; }
.phase-label { position: absolute; top: 26%; align-self: center; padding: 6px 24px; font-size: 64px; color: rgb(255,225,159); -unity-font-definition: url("ChineseBold.asset"); text-shadow: 0 3px 3px rgba(12,32,31,0.80); }
.phase-label.recovering { top: 176px; font-size: 23px; padding: 8px 18px; background-color: rgba(16,36,39,0.62); border-radius: 12px; }
.countdown-overlay { position: absolute; top: 19%; align-self: center; width: 224px; height: 242px; }
.countdown-number { position: absolute; left: 0; right: 0; top: 21px; height: 160px; font-size: 116px; -unity-font-definition: url("ChineseBold.asset"); -unity-text-align: middle-center; color: rgb(255,247,217); text-shadow: 0 4px 2px rgba(12,32,31,0.80); }
.countdown-caption { position: absolute; top: 169px; left: -30px; right: -30px; font-size: 13px; -unity-text-align: middle-center; color: rgb(224,239,221); text-shadow: 0 2px 2px rgba(12,32,31,0.85); letter-spacing: 2px; }
.countdown-overlay.kickoff .countdown-number { font-size: 54px; color: rgb(164,244,211); }
.countdown-overlay.kickoff .countdown-caption { font-size: 13px; }
.training-tools { width: 940px; max-width: 94%; flex-wrap: wrap; justify-content: center; position: absolute; top: 95px; align-self: center; flex-direction: row; align-items: center; padding: 3px 10px; background-color: rgba(12,31,37,0.95); border-radius: 8px; border-width: 1px; border-color: rgb(71,99,94); }
.training-tools .skill-heading { color: rgb(233,200,120); margin: 0 10px 0 0; font-size: 12px; }
.training-tools Button { color: rgb(221,237,220); background-color: rgb(34,65,69); border-color: rgb(89,121,115); border-bottom-color: rgb(11,33,40); min-height: 27px; padding: 5px 9px; margin: 2px 5px 2px 0; font-size: 12px; border-bottom-width: 2px; border-radius: 5px; }
.training-tools Button:hover { background-color: rgb(48,85,86); border-color: rgb(225,192,123); }
.hud-bottom-anchor { position: absolute; left: 0; right: 0; bottom: 7px; align-items: center; }
.hud-bottom { padding: 8px 12px; flex-direction: row; align-items: center; flex-shrink: 0; }
.minimap { position: absolute; left: 22px; bottom: 7px; background-color: rgba(9,29,36,0.68); border-width: 1px; border-color: rgba(139,185,167,0.48); border-top-color: rgba(212,192,133,0.68); border-radius: 9px; }
.minimap-heading { position: absolute; left: 10px; right: 10px; top: 4px; height: 16px; flex-direction: row; align-items: center; }
.minimap-heading Label { margin: 0; font-size: 10px; }
.minimap-title { flex-grow: 1; color: rgb(236,222,186); -unity-font-definition: url("ChineseBold.asset"); letter-spacing: 1px; }
.minimap-heading .minimap-allies { color: rgb(111,232,199); margin-right: 10px; }
.minimap-enemies { color: rgb(255,170,108); }
.minimap-player { position: absolute; border-radius: 16px; background-color: rgb(6,19,25); border-width: 1.5px; }
.minimap-ally { border-color: rgb(99,230,195); }
.minimap-enemy { border-color: rgb(255,158,99); }
.minimap-local { border-color: rgb(255,237,164); border-width: 2px; }
.minimap-portrait { position: absolute; left: 1px; right: 1px; top: 1px; bottom: 1px; border-radius: 14px; -unity-background-scale-mode: scale-and-crop; }
.minimap-badge { position: absolute; right: -2px; bottom: -4px; min-width: 10px; height: 11px; margin: 0; padding: 0 2px; font-size: 8px; color: rgb(241,244,229); background-color: rgba(7,23,29,0.94); border-radius: 4px; -unity-text-align: middle-center; }
.minimap-local .minimap-badge { color: rgb(255,237,164); }
.minimap-down { position: absolute; right: -4px; top: -5px; width: 12px; height: 12px; margin: 0; font-size: 12px; color: rgb(242,208,194); background-color: rgba(36,23,29,0.94); border-radius: 7px; -unity-text-align: middle-center; }
.minimap-knocked-out .minimap-portrait { opacity: 0.30; }
.minimap-knocked-out { border-color: rgb(145,149,144); }
.minimap-possession { position: absolute; left: -4px; top: -3px; width: 8px; height: 8px; border-radius: 5px; background-color: rgb(255,249,215); border-width: 1px; border-color: rgb(241,187,82); }
.dock-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-image: url("../Resources/FrontEnd/ui-dock-v2.png"); -unity-background-scale-mode: stretch-to-fill; opacity: 0.64; }
.hud-stat-strip Label, .ability-caption, .ability-cost, .hero-name, .hero-state, .hud-help Label { text-shadow: 0 1px 2px rgba(0,0,0,0.95); }
.hero-summary { width: 66px; align-items: center; margin-right: 10px; }
.hero-portrait-frame { width: 60px; height: 60px; border-width: 2px; border-color: rgb(143,188,167); border-radius: 32px; overflow: hidden; background-color: rgb(5,19,26); }
.hero-symbol { position: absolute; left: 2px; top: 2px; right: 2px; bottom: 2px; border-radius: 44px; -unity-background-scale-mode: scale-and-crop; }
.portrait-down .hero-symbol { opacity: 0.35; }
.portrait-possession { border-color: rgb(240,201,124); }
.hero-name { -unity-font-definition: url("ChineseBold.asset"); font-size: 13px; color: rgb(247,236,202); margin-top: 4px; -unity-text-align: middle-center; }
.hero-state { font-size: 10px; color: rgb(142,215,184); white-space: normal; -unity-text-align: middle-center; margin-top: 2px; }
.hud-main { width: 400px; }
.hud-stat-strip { display: none; }
.hud-stat-strip Label { font-size: 10px; color: rgb(127,159,158); }
.hud-stat-strip .dock-heading { color: rgb(224,207,158); letter-spacing: 1px; font-size: 11px; }
.hud-stat-strip .bomb-action { color: rgb(255,206,119); position: absolute; right: 0; top: -20px; }
.ability-strip { align-items: flex-start; justify-content: space-between; }
.skill-tile { width: 60px; align-items: center; flex-shrink: 0; }
.ability-frame { width: 54px; height: 54px; background-color: rgb(8,23,31); border-width: 2px; border-color: rgb(96,117,118); border-bottom-color: rgb(44,65,70); border-radius: 7px; overflow: hidden; }
.skill-symbol { position: absolute; left: 2px; top: 2px; right: 2px; bottom: 2px; border-radius: 4px; -unity-background-scale-mode: scale-and-crop; }
.cooldown-mask { position: absolute; left: 2px; right: 2px; top: 2px; bottom: 2px; }
.cooldown-number { position: absolute; left: 0; right: 0; top: 0; bottom: 0; margin: 0; padding-top: 4px; font-size: 22px; -unity-font-definition: url("ChineseBold.asset"); -unity-text-align: middle-center; color: rgb(255,251,226); text-shadow: 0 2px 2px rgba(0,0,0,0.95); }
.skill-tile.blocked .cooldown-number { font-size: 10px; }
.ability-key { position: absolute; left: 2px; top: 2px; font-size: 10px; -unity-font-definition: url("ChineseBold.asset"); margin: 0; padding: 3px 5px; background-color: rgba(4,16,23,0.93); color: rgb(251,235,190); border-bottom-right-radius: 5px; border-bottom-width: 1px; border-bottom-color: rgb(107,116,96); }
.ability-caption { font-size: 10px; margin: 3px 0 0; color: rgb(230,230,209); -unity-text-align: middle-center; }
.ability-cost { font-size: 9px; margin: 1px 0 1px; color: rgb(157,189,181); -unity-text-align: middle-center; }
.ability-divider { width: 1px; height: 53px; background-color: rgb(102,117,105); margin: 1px 3px 0; flex-shrink: 0; }
.skill-tile.cooling .skill-symbol { opacity: 0.80; }
.skill-tile.cooling .cooldown-mask { background-color: rgba(4,12,17,0.25); }
.skill-tile.blocked .skill-symbol { opacity: 0.28; }
.skill-tile.armed .ability-frame { border-color: rgb(250,207,110); }
.ability-gleam { position: absolute; left: 0; top: 0; width: 38px; bottom: 0; background-image: url("../Resources/FrontEnd/ui-glint-v2.png"); opacity: 0; }
.resource-deck { margin-top: 2px; }
.resource-progress { height: 16px; margin: 2px 0 0; }
.resource-progress .unity-progress-bar__background { border-width: 1px; border-color: rgb(4,15,21); border-top-color: rgb(42,76,75); background-color: rgb(5,19,26); border-radius: 4px; overflow: hidden; }
.resource-progress .unity-progress-bar__progress { border-width: 0; border-radius: 2px; background-image: url("../Resources/FrontEnd/ui-resource-fill-v2.png"); -unity-background-scale-mode: stretch-to-fill; background-color: transparent; transition-property: width; transition-duration: 0.12s; }
.resource-progress .unity-progress-bar__title { font-size: 10px; -unity-font-definition: url("ChineseBold.asset"); color: rgb(244,251,238); text-shadow: 0 1px 2px rgba(0,0,0,0.95); }
.health-progress .unity-progress-bar__progress { -unity-background-image-tint-color: rgb(71,212,150); }
.energy-progress .unity-progress-bar__progress { -unity-background-image-tint-color: rgb(80,171,226); }
.resource-trail { position: absolute; left: 0; top: 0; bottom: 0; background-color: transparent; background-image: url("../Resources/FrontEnd/ui-resource-fill-v2.png"); -unity-background-image-tint-color: rgb(209,166,98); border-radius: 2px; }
.energy-progress .resource-trail { -unity-background-image-tint-color: rgb(106,144,170); }
.resource-ticks { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.resource-tick { position: absolute; top: 0; bottom: 0; width: 1px; background-color: rgba(0,12,17,0.25); }
.resource-delta { position: absolute; right: 7px; font-size: 14px; -unity-font-definition: url("ChineseBold.asset"); color: rgb(255,215,154); opacity: 0; text-shadow: 0 1px 2px rgba(0,0,0,0.95); }
.energy-delta { top: 19px; }
.hud-help { display: none; }
.hud-help Label { font-size: 10px; color: rgb(136,167,166); margin: 4px 0; }
.hud-help .hud-help-title { color: rgb(220,201,151); font-size: 12px; letter-spacing: 1px; margin-bottom: 8px; }
.charge-progress { height: 18px; margin: 6px 0 0; }
.charge-progress .unity-progress-bar__background { background-color: rgb(9,28,42); border-width: 0; border-radius: 3px; }
.charge-progress .unity-progress-bar__progress { background-color: rgb(248,201,106); border-width: 0; border-radius: 3px; }
.charge-progress .unity-progress-bar__title { font-size: 10px; color: rgb(20,45,61); }
.skill-tooltip { position: absolute; width: 280px; padding: 13px 15px 12px; border-radius: 10px; background-color: rgba(10,29,34,0.94); border-width: 1px; border-color: rgb(109,152,139); border-top-width: 2px; border-top-color: rgb(207,184,118); }
.skill-tooltip-title { margin: 0 0 8px; font-size: 16px; -unity-font-definition: url("ChineseBold.asset"); color: rgb(251,225,172); white-space: normal; }
.skill-tooltip-body { margin: 0 0 9px; font-size: 12px; color: rgb(221,234,222); white-space: normal; }
.skill-tooltip-meta { margin: 0 0 7px; padding-top: 8px; border-top-width: 1px; border-top-color: rgba(145,186,168,0.25); font-size: 11px; color: rgb(157,201,186); white-space: normal; }
.skill-tooltip-state { margin: 0; font-size: 11px; color: rgb(239,198,121); white-space: normal; }
.damage-vignette { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-image: url("../Resources/FrontEnd/ui-damage-v2.png"); opacity: 0; }
.combat-toast { position: absolute; bottom: 222px; align-self: center; padding: 7px 22px; background-color: rgba(5,21,29,0.94); border-radius: 8px; border-top-width: 1px; border-top-color: rgb(131,162,142); font-size: 18px; -unity-font-definition: url("ChineseBold.asset"); opacity: 0; }
/* Dialogs / report / preferences */
.overlay { position: absolute; top: 0; bottom: 0; left: 0; right: 0; background-color: rgba(8,24,41,0.72); align-items: center; justify-content: center; }
.modal { width: 420px; padding: 32px; color: rgb(30,48,62); background-color: rgb(245,247,237); border-radius: 20px; border-width: 1px; border-color: rgb(255,255,247); border-bottom-width: 7px; border-bottom-color: rgb(135,160,166); }
.modal Button { margin-top: 13px; }
.results { align-items: center; justify-content: center; }
.result-score { font-size: 80px; color: rgb(33,131,126); -unity-font-definition: url("ChineseBold.asset"); margin: 6px 0 15px; }
.result-stats { margin: 28px 0; padding: 20px 10px; border-radius: 12px; background-color: rgb(225,235,226); }
.stat { width: 165px; align-items: center; border-right-width: 1px; border-right-color: rgb(198,214,209); }
.stat-number { font-size: 42px; color: rgb(171,126,52); margin-bottom: 7px; }
.combat-summary { margin-top: 10px; }
.settings { max-width: 860px; align-self: center; width: 80%; min-height: 0; }
.settings .description { font-size: 17px; margin-bottom: 14px; }
.settings Slider { margin: 10px 0; height: 28px; }
.settings .unity-base-field__label { min-width: 112px; color: rgb(69,105,116); font-size: 17px; }
.settings .unity-slider__tracker { height: 5px; background-color: rgb(185,206,199); border-radius: 3px; }
.settings .unity-slider__dragger { width: 20px; height: 20px; background-color: rgb(57,144,136); border-width: 3px; border-color: rgb(246,249,239); border-radius: 12px; }
.settings .unity-base-slider__tracker { height: 5px; background-color: rgb(185,206,199); border-width: 0; border-radius: 3px; }
.settings .unity-base-slider__dragger { width: 20px; height: 20px; background-image: none; background-color: rgb(57,144,136); border-width: 3px; border-color: rgb(246,249,239); border-radius: 12px; }
.settings .unity-base-slider__dragger-border { display: none; }
.settings-toggles { margin: 18px 0; align-items: flex-start; }
.settings .settings-toggles Button { margin-right: 12px; font-size: 16px; }
.settings Button { align-self: flex-start; }
.settings .hud-setting-copy { font-size: 13px; margin-bottom: 8px; }
/* Smaller windows keep every main action in view. */
.compact-front-end .game-home { padding-top: 18px; padding-bottom: 18px; }
.compact-front-end .home-wordmark { margin-bottom: 27px; }
.compact-front-end .home-brand-title { font-size: 58px; }
.compact-front-end .home-brand-line { margin-top: 12px; }
.compact-front-end Button.home-nav { min-height: 53px; font-size: 25px; }
.compact-front-end Button.home-nav-primary { min-height: 77px; }
.compact-front-end .home-nav-title { font-size: 31px; }
.compact-front-end Button.home-nav-small { min-height: 45px; font-size: 21px; margin-top: 5px; }
.compact-front-end .page { margin: 25px 38px; padding: 25px; }
.compact-front-end .selection .page-title { font-size: 30px; }
.compact-front-end .selection .description { font-size: 14px; }
.compact-front-end .settings .description { font-size: 16px; }
.narrow-front-end .game-home, .narrow-front-end .multiplayer-menu { padding-left: 38px; padding-right: 38px; }
.narrow-front-end .home-connection { font-size: 12px; margin-right: 12px; }
.narrow-front-end .home-navigation { width: 320px; }
.narrow-front-end .multiplayer-title { font-size: 40px; }

/* Shared actions expose separate cooldowns and health costs. */

/* Compact room forms show optional controls only when expanded. */
.network-page { flex-grow: 0; flex-shrink: 1; width: 720px; max-width: 92%; align-self: center; margin: 32px 0; padding: 24px; }
.network-page .page-heading { margin-bottom: 8px; }
.network-page .page-title { font-size: 28px; margin-bottom: 4px; }
.network-page .eyebrow { font-size: 12px; letter-spacing: 0; margin-bottom: 5px; }
.network-scroll { flex-grow: 0; flex-shrink: 1; height: 300px; }
.network-lobby { width: 860px; }
.network-lobby .network-scroll { height: 310px; }
.network-tabs { margin-bottom: 10px; }
.network-tabs Button { flex-grow: 1; min-width: 0; margin-right: 8px; padding-top: 8px; padding-bottom: 8px; }
.network-card { background-color: rgba(220,231,223,.55); border-radius: 12px; padding: 12px 16px; margin-bottom: 8px; }
.network-card .skill-heading { margin-top: 0; font-size: 16px; }
.network-page .unity-base-field { margin: 4px 0 10px; min-height: 34px; font-size: 16px; }
.network-page .unity-base-field__label { min-width: 84px; max-width: 120px; white-space: normal; color: rgb(39,64,70); }
.network-page .unity-base-field__input { min-width: 0; min-height: 32px; background-color: rgb(251,252,246); color: rgb(31,47,57); border-radius: 6px; padding: 4px 8px; }
.network-page .unity-text-field__input { color: rgb(31,47,57); }
.network-page Button { min-height: 38px; font-size: 16px; }
.network-card Button.primary { align-self: stretch; min-width: 0; margin: 10px 0 0; font-size: 18px; }
.network-disclosure { margin-top: 8px; margin-bottom: 8px; }
.network-disclosure > .unity-foldout__toggle { margin-top: 0; margin-bottom: 0; font-size: 15px; color: rgb(72,103,111); }
.network-disclosure > .unity-foldout__content { margin-left: 0; padding-left: 4px; padding-top: 8px; }
.network-status { color: rgb(34,109,109); white-space: normal; margin: 8px 0 0; font-size: 15px; min-height: 20px; }
.network-teams { align-items: stretch; }
.network-teams > .network-card { width: 48%; min-width: 0; margin-right: 8px; padding: 10px 12px; }
.network-member { padding: 8px; margin: 4px 0; border-radius: 7px; background-color: rgba(250,252,245,.85); min-height: 52px; justify-content: center; }
.network-member.local-member { border-width: 1px; border-color: rgb(194,147,67); }
.network-member.empty-member { background-color: rgba(250,252,245,.35); }
.network-member-name { font-size: 16px; color: rgb(32,54,64); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.empty-member .network-member-name { color: rgb(137,154,159); font-size: 14px; }
.network-member-detail { color: rgb(75,100,108); font-size: 13px; margin-top: 2px; }
.lobby-invitation { flex-shrink: 0; margin-bottom: 8px; }
.lobby-invite-field { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; }
.lobby-invite-field .unity-base-field__input { min-width: 0; flex-shrink: 1; font-size: 22px; letter-spacing: 2px; }
.lobby-invitation > Button { flex-shrink: 0; margin-left: 8px; }
.network-footer { margin-top: 8px; align-items: center; }
.network-footer Button { min-width: 140px; margin-left: 12px; }
.discovery-room { margin-top: 6px; justify-content: space-between; align-items: center; padding: 6px 8px; background-color: rgba(248,250,241,.9); border-radius: 7px; }
.discovery-room Label { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 15px; color: rgb(34,59,65); white-space: normal; }
.discovery-room Button { flex-shrink: 0; padding: 6px 12px; }
.compact-front-end .network-page { margin-top: 16px; margin-bottom: 16px; padding-top: 18px; padding-bottom: 18px; }
.compact-front-end .network-page .page-title { font-size: 25px; }
.compact-front-end .network-scroll { height: 280px; }
.narrow-front-end .network-page { max-width: 94%; }

.login-page { width: 660px; max-width: 90%; align-self: center; margin-top: 70px; padding: 32px; }
.login-page .unity-base-field { margin-top: 18px; min-height: 38px; font-size: 17px; }
.login-page .unity-base-field__label { min-width: 165px; }
.login-page .unity-base-field__input { background-color: rgb(251,252,246); padding: 5px 10px; }
.login-actions { margin-top: 20px; justify-content: space-between; }
.login-actions Button { min-width: 220px; min-height: 46px; }
.compact-front-end .login-page { margin-top: 28px; padding: 24px; }

/* Bindings occupy their own scrollable tab. */
.settings-heading { flex-shrink: 0; margin-bottom: 6px; }
.settings-heading .page-title { margin-bottom: 0; }
.settings-tabs { margin-bottom: 18px; border-bottom-width: 1px; border-bottom-color: rgb(197,212,207); }
.settings Button.settings-tab { min-width: 100px; min-height: 40px; margin: 0 12px 0 0; border-width: 0; border-bottom-width: 3px; border-radius: 0; background-color: rgba(0,0,0,0); color: rgb(101,128,140); }
.settings Button.settings-tab-selected { color: rgb(32,100,111); border-bottom-color: rgb(44,129,129); }
.settings-general { flex-grow: 1; }
.settings-keys { flex-grow: 1; min-height: 0; }
.keys-heading { flex-shrink: 0; margin-bottom: 8px; }
.keys-heading Button { margin: 0; min-height: 36px; font-size: 14px; }
.keys-scroll { flex-grow: 1; min-height: 0; }
.binding-group { color: rgb(33,108,117); font-size: 14px; margin: 13px 0 6px; -unity-font-definition: url("ChineseBold.asset"); }
.binding-row { flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: rgb(217,227,220); padding: 3px 0; }
.binding-row Label { font-size: 16px; }
.settings Button.binding-key { width: 150px; min-height: 35px; padding: 5px 10px; margin: 2px 12px 2px 0; font-size: 14px; border-width: 1px; border-radius: 3px; -unity-text-align: middle-center; }
.settings Button.binding-capturing { background-color: rgb(255,218,134); border-color: rgb(163,123,52); }
.fixed-mouse-keys { font-size: 13px; color: rgb(105,130,142); white-space: normal; margin: 20px 0; }
.keys-status { height: 42px; flex-shrink: 0; font-size: 13px; color: rgb(144,101,39); padding-top: 12px; white-space: normal; }

/* Settings share the front end's dark surfaces and readable action rows. */
.settings { background-color: rgb(14,29,43); color: rgb(221,233,241); border-width: 1px; border-color: rgba(157,186,203,0.28); border-radius: 3px; }
.settings .page-title { color: rgb(238,244,245); }
.settings .muted, .settings .fixed-mouse-keys { color: rgb(146,174,193); }
.settings .unity-base-field__label { color: rgb(191,212,225); }
.settings Button.secondary { color: rgb(207,225,235); background-color: rgb(31,53,70); border-width: 1px; border-color: rgb(67,94,112); border-radius: 2px; }
.settings Button.secondary:hover { background-color: rgb(45,70,89); }
.settings .unity-base-slider__tracker { background-color: rgb(59,83,100); }
.settings .unity-base-slider__dragger { border-color: rgb(203,226,236); background-color: rgb(98,180,187); }
.settings-tabs { border-bottom-color: rgb(56,78,95); }
.settings Button.settings-tab { color: rgb(149,176,195); border-bottom-color: rgba(0,0,0,0); }
.settings Button.settings-tab-selected { color: rgb(255,205,116); border-bottom-color: rgb(255,183,70); }
.binding-group { color: rgb(125,203,210); }
.binding-row { border-bottom-color: rgb(38,59,77); }
.settings Button.binding-key { background-color: rgb(28,49,66); color: rgb(222,234,242); border-color: rgb(71,96,114); }
.settings Button.binding-key:hover { background-color: rgb(44,70,89); }
.settings Button.binding-capturing { background-color: rgb(122,89,42); border-color: rgb(255,193,89); color: rgb(255,234,194); }
.keys-status { color: rgb(245,197,117); }
.keys-scroll .unity-scroller--vertical { width: 8px; margin-left: 10px; }
.keys-scroll .unity-scroller__low-button, .keys-scroll .unity-scroller__high-button { display: none; }
.keys-scroll .unity-base-slider__tracker { background-color: rgb(35,54,70); }
.keys-scroll .unity-base-slider__dragger { background-color: rgb(92,137,156); border-width: 0; border-radius: 3px; }

/* Choose mode before assembling a match. */
.play-menu { flex-grow: 1; padding: 46px 58px; }
.play-heading { margin-bottom: 36px; }
.play-title { font-size: 42px; -unity-font-definition: url("ChineseBold.asset"); color: rgb(239,245,245); }
.play-options { width: 510px; max-width: 48%; flex-grow: 1; justify-content: center; padding-bottom: 50px; }
Button.play-option { background-color: rgba(24,43,59,0.94); color: rgb(225,237,242); border-width: 1px; border-left-width: 3px; border-color: rgb(62,86,102); border-radius: 0; margin: 0 0 13px; padding: 19px 23px; align-items: flex-start; }
Button.play-option:hover, Button.play-option:focus { background-color: rgb(44,68,87); border-left-color: rgb(255,183,70); }
.play-option-name { font-size: 27px; -unity-font-definition: url("ChineseBold.asset"); }
.play-option-note { font-size: 13px; color: rgb(158,185,203); margin-top: 7px; }
/* Draft reuses the 3D selection viewport and adds roster and opening placement. */
.draft-roster { margin-top: 14px; }
.draft-section-label { color: rgb(154,192,209); font-size: 12px; margin-bottom: 8px; }
.draft-member { font-size: 12px; white-space: normal; padding: 8px; margin-bottom: 4px; background-color: rgba(13,31,45,0.9); color: rgb(147,174,191); border-left-width: 2px; border-left-color: rgba(0,0,0,0); }
.draft-member-current { color: rgb(255,213,135); border-left-color: rgb(255,193,89); }
.draft-member-locked { color: rgb(136,214,199); }
.draft-placement { margin-top: 9px; padding: 10px 12px; height: 225px; flex-shrink: 0; background-color: rgba(10,25,37,0.95); border-width: 1px; border-color: rgb(44,76,94); }
.draft-map { flex-grow: 1; min-height: 0; }
.draft-turn { font-size: 13px; color: rgb(244,204,131); }
.draft-position-note { font-size: 12px; color: rgb(161,185,203); white-space: normal; margin-top: 2px; }
.narrow-front-end .draft-placement { height: 210px; }
/* Guided exercises keep the pitch interactive and use current bindings in their copy. */
.tutorial-panel { position: absolute; left: 22px; top: 120px; width: 370px; max-width: 36%; padding: 18px; background-color: rgba(10,24,37,0.94); border-width: 1px; border-color: rgb(62,100,118); border-radius: 3px; }
.tutorial-progress { font-size: 12px; color: rgb(112,189,201); }
.tutorial-title { font-size: 24px; color: rgb(243,236,213); -unity-font-definition: url("ChineseBold.asset"); margin-top: 13px; margin-bottom: 12px; white-space: normal; }
.tutorial-body { font-size: 14px; color: rgb(177,203,218); white-space: normal; margin-bottom: 17px; }
.tutorial-objective { font-size: 15px; color: rgb(249,207,119); white-space: normal; margin-bottom: 9px; }
.tutorial-status { font-size: 12px; color: rgb(140,176,189); white-space: normal; }
.tutorial-actions { margin-top: 15px; flex-wrap: wrap; }
Button.tutorial-utility { font-size: 12px; padding: 5px 8px; min-height: 28px; margin: 0 5px 4px 0; border-width: 1px; border-color: rgb(56,91,111); border-radius: 2px; color: rgb(184,211,224); background-color: rgb(25,46,62); }
Button.tutorial-next { font-size: 13px; min-height: 30px; margin: 0 0 4px; padding: 6px 12px; border-width: 1px; border-radius: 2px; color: rgb(32,43,46); background-color: rgb(239,191,91); }
Button.tutorial-next:disabled { background-color: rgb(42,59,69); color: rgb(103,132,149); border-color: rgb(57,81,96); }
.tutorial-marker { position: absolute; width: 44px; height: 44px; border-radius: 25px; border-width: 3px; border-color: rgb(255,208,98); background-color: rgba(255,198,80,0.1); }

/* Keyboard selection remains explicit when a menu regains focus. */
Button.home-nav.home-selected { border-left-color: rgb(255,183,70); background-color: rgba(119,153,171,0.20); color: rgb(255,223,166); }
Button.home-nav-primary { border-left-color: rgba(255,183,70,0); background-color: rgba(10,23,35,0.18); }
Button.home-nav-primary.home-selected { background-color: rgba(169,124,54,0.24); border-left-color: rgb(255,183,70); }
.home-coins { font-size: 14px; color: rgb(239,198,105); margin-right: 26px; }
/* Prototype shop: actual balance, starter heroes, and future skin category. */
.shop-page { flex-grow: 1; padding: 38px 58px; }
.shop-heading { margin-bottom: 25px; }
.shop-title { font-size: 42px; color: rgb(240,245,245); -unity-font-definition: url("ChineseBold.asset"); }
.shop-content { width: 780px; max-width: 67%; }
.shop-wallet { padding: 24px; background-color: rgba(15,32,46,0.95); border-width: 1px; border-color: rgb(64,93,107); }
.shop-profile { font-size: 12px; color: rgb(158,188,203); margin-bottom: 12px; }
.shop-currency { font-size: 14px; color: rgb(221,193,131); }
.shop-balance { font-size: 40px; color: rgb(255,205,104); -unity-font-definition: url("ChineseBold.asset"); }
.shop-earning { padding-left: 30px; border-left-width: 1px; border-left-color: rgb(64,93,107); }
.shop-earning-title { font-size: 14px; color: rgb(197,217,226); margin-bottom: 8px; }
.shop-earning-amount { font-size: 24px; color: rgb(255,205,104); margin-bottom: 9px; }
.shop-note { color: rgb(149,177,194); font-size: 12px; white-space: normal; }
.shop-status { margin-top: 10px; }
.shop-tabs { margin-top: 24px; margin-bottom: 18px; }
Button.shop-tab { min-width: 100px; background-color: rgba(18,37,52,0.92); color: rgb(170,197,213); border-radius: 0; border-width: 1px; border-color: rgb(53,82,100); }
Button.shop-tab-selected { color: rgb(251,212,140); border-bottom-width: 2px; border-bottom-color: rgb(246,191,85); }
.shop-item { width: 48%; padding: 18px; margin-right: 15px; background-color: rgba(15,32,46,0.95); border-width: 1px; border-color: rgb(48,79,96); }
.shop-portrait { height: 160px; -unity-background-scale-mode: scale-to-fit; }
.shop-item-name { margin-top: 13px; font-size: 24px; color: rgb(238,241,228); -unity-font-definition: url("ChineseBold.asset"); }
.shop-owned { margin-top: 9px; font-size: 13px; color: rgb(131,213,188); }
.shop-coming { margin-top: 15px; }
.shop-empty { height: 250px; justify-content: center; align-items: center; background-color: rgba(15,32,46,0.95); border-width: 1px; border-color: rgb(48,79,96); }
.shop-empty-title { font-size: 27px; color: rgb(224,235,239); margin-bottom: 14px; }
.result-wallet { margin-top: 10px; margin-bottom: 8px; padding: 12px 16px; background-color: rgb(226,232,222); border-radius: 4px; }
.result-reward { font-size: 19px; color: rgb(130,93,38); white-space: normal; }
.result-coins { font-size: 14px; color: rgb(99,121,117); }
.compact-front-end .shop-page { padding-top: 22px; padding-bottom: 22px; }
.compact-front-end .shop-heading { margin-bottom: 15px; }
.compact-front-end .shop-wallet { padding: 15px 20px; }
.compact-front-end .shop-portrait { height: 125px; }
.compact-front-end .shop-tabs { margin-top: 14px; margin-bottom: 12px; }
.narrow-front-end .shop-content { max-width: 77%; }

Button.shop-tab:hover { background-color: rgb(34,58,76); border-color: rgb(163,145,105); }

.result-coins { margin-left: 18px; }

/* Character overview keeps effects prominent and parameters available on demand. */
.character-details { width: 430px; padding: 22px; border-left-width: 0; background-color: rgba(9,21,32,0.86); }
.narrow-front-end .character-details { width: 335px; padding: 16px; }
.character-showcase { justify-content: center; }
.character-preview { max-height: 470px; background-color: rgb(9,17,23); }
.selection-summary { font-size: 17px; color: rgb(207,221,225); white-space: normal; margin-bottom: 20px; }
.selection-ability { padding: 13px 10px; margin-bottom: 10px; border-width: 1px; border-color: rgb(41,66,83); background-color: rgba(26,45,60,0.72); align-items: flex-start; }
.selection-ability-art { width: 48px; height: 48px; flex-shrink: 0; margin-right: 13px; border-radius: 4px; -unity-background-scale-mode: scale-to-fit; }
.selection .selection-ability .skill-heading { margin-top: 0; margin-bottom: 6px; color: rgb(234,224,192); font-size: 16px; }
.selection .selection-ability .description { margin-bottom: 0; font-size: 14px; }
.selection-controls { font-size: 12px; color: rgb(163,185,199); white-space: normal; margin-top: 4px; margin-bottom: 18px; }
.character-parameters > Toggle { margin-bottom: 12px; color: rgb(147,185,201); font-size: 13px; }
.character-parameters .stats-copy { font-size: 12px; color: rgb(169,190,201); }
.parameter-copy { font-size: 12px; color: rgb(154,179,194); white-space: normal; margin-bottom: 15px; }
.compact-front-end .selection-summary { font-size: 14px; margin-bottom: 13px; }
.compact-front-end .selection-ability { padding: 10px 8px; margin-bottom: 7px; }
.compact-front-end .selection-ability-art { width: 39px; height: 39px; margin-right: 10px; }
.compact-front-end .home-wordmark { margin-bottom: 17px; }
.compact-front-end Button.home-nav { min-height: 47px; margin-bottom: 5px; }
/* Simple locally saved match history. */
.history-page { flex-grow: 1; margin: 34px 58px; }
.history-heading { margin-bottom: 22px; flex-shrink: 0; }
.history-title { font-size: 39px; color: rgb(240,244,243); -unity-font-definition: url("ChineseBold.asset"); }
.history-profile { font-size: 13px; color: rgb(153,183,197); white-space: normal; margin-top: 8px; }
.history-status { font-size: 13px; color: rgb(235,191,126); white-space: normal; }
.history-content { flex-grow: 1; min-height: 0; align-items: stretch; }
.history-list { flex-grow: 1; flex-basis: 0; min-height: 0; margin-right: 20px; }
.history-detail { width: 340px; max-width: 40%; flex-shrink: 0; padding: 24px; background-color: rgba(12,29,42,0.94); border-width: 1px; border-color: rgb(49,77,94); }
Button.history-row { padding: 17px 20px; margin: 0 0 10px; border-radius: 0; border-width: 1px; border-left-width: 3px; border-color: rgb(43,69,87); background-color: rgba(15,32,46,0.94); color: rgb(195,218,229); align-items: stretch; }
Button.history-row:hover { background-color: rgb(32,53,69); }
Button.history-row-selected { border-left-color: rgb(246,193,94); background-color: rgb(30,49,64); }
.history-result { font-size: 21px; width: 68px; -unity-font-definition: url("ChineseBold.asset"); }
.history-victory { color: rgb(117,221,188); }
.history-defeat { color: rgb(218,149,133); }
.history-draw { color: rgb(187,195,191); }
.history-role { font-size: 16px; }
.history-score { font-size: 22px; color: rgb(240,224,176); }
.history-meta { margin-top: 10px; font-size: 12px; color: rgb(138,169,188); }
.history-detail-title { font-size: 29px; color: rgb(239,220,178); -unity-font-definition: url("ChineseBold.asset"); }
.history-detail-meta { font-size: 14px; color: rgb(153,188,204); white-space: normal; margin-top: 18px; }
.history-detail-stats { font-size: 16px; color: rgb(195,213,221); white-space: normal; margin-top: 30px; }
.history-detail-coins { font-size: 17px; color: rgb(240,203,127); margin-top: 30px; }
.history-empty { position: absolute; top: 27%; left: 0; right: 0; padding: 40px; align-items: center; }
.history-empty-title { font-size: 28px; color: rgb(229,236,230); }
.history-list .unity-scroller--vertical { width: 8px; }
.history-list .unity-scroller__low-button,.history-list .unity-scroller__high-button { display: none; }
.history-list .unity-base-slider__tracker { background-color: rgb(30,52,67); }
.history-list .unity-base-slider__dragger { background-color: rgb(88,129,143); }
.compact-front-end .history-page { margin: 22px 38px; }
.compact-front-end .history-detail { padding: 19px; width: 290px; }

/* Profiles and friends share the understated front-end panels. */
.social-page { flex-grow: 1; margin: 34px 58px; min-height: 0; }
.social-heading { margin-bottom: 18px; flex-shrink: 0; align-items: center; }
.social-title { font-size: 37px; color: rgb(238,245,244); -unity-font-definition: url("ChineseBold.asset"); }
.social-section { font-size: 20px; color: rgb(221,233,235); margin-bottom: 10px; -unity-font-definition: url("ChineseBold.asset"); }
.social-copy { font-size: 15px; color: rgb(191,211,220); white-space: normal; }
.social-muted { font-size: 12px; color: rgb(149,179,195); white-space: normal; }
.social-status { font-size: 13px; color: rgb(244,197,116); white-space: normal; min-height: 20px; flex-shrink: 0; }
Button.social-action { padding: 8px 13px; margin: 0 0 0 8px; min-height: 32px; background-color: rgb(29,49,65); border-width: 1px; border-color: rgb(57,84,102); border-radius: 0; color: rgb(224,231,225); font-size: 13px; flex-shrink: 0; }
Button.social-action:hover { background-color: rgb(42,65,83); border-color: rgb(205,170,109); }
Button.social-action:disabled { color: rgb(111,139,151); background-color: rgb(20,37,48); }
.profile-metrics { padding: 16px 24px; background-color: rgba(12,28,40,.94); margin-bottom: 16px; flex-shrink: 0; }
.profile-metric { width: 33%; padding-left: 18px; }
.profile-number { font-size: 34px; color: rgb(245,207,132); -unity-font-definition: url("ChineseBold.asset"); margin-bottom: 5px; }
.profile-heroes { flex-shrink: 0; margin-bottom: 18px; }
Button.profile-hero { flex-basis: 0; flex-grow: 1; flex-direction: row; align-items: center; padding: 14px; margin: 0 12px 0 0; border-color: rgb(47,75,92); border-left-width: 3px; background-color: rgba(17,34,47,.96); }
Button.profile-hero-selected { border-left-color: rgb(245,193,103); background-color: rgb(31,50,64); }
.profile-portrait { width: 75px; height: 75px; margin-right: 16px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.profile-hero-name { font-size: 22px; color: rgb(235,240,233); margin-bottom: 6px; -unity-font-definition: url("ChineseBold.asset"); }
.profile-recent-heading { align-items: center; margin-bottom: 10px; flex-shrink: 0; }
.profile-recent { flex-grow: 1; min-height: 0; }
.profile-match { min-height: 58px; padding: 12px 18px; margin-bottom: 7px; background-color: rgba(14,31,44,.94); align-items: center; }
.profile-score { font-size: 19px; color: rgb(240,217,165); width: 100px; }
.friends-online { flex-grow: 1; min-height: 0; }
.friend-search-row { flex-shrink: 0; align-items: center; margin-bottom: 10px; }
.friend-search-row TextField { max-width: 450px; color: rgb(200,217,225); }
.friend-search-row .unity-base-field__input { min-height: 38px; background-color: rgb(19,37,51); border-color: rgb(57,83,104); color: rgb(233,240,241); }
.friends-columns { flex-grow: 1; min-height: 0; margin-top: 20px; }
.friends-column { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 18px; margin-right: 14px; background-color: rgba(12,28,40,.94); }
.friends-list { flex-grow: 1; min-height: 0; }
.social-person { min-height: 65px; align-items: center; padding: 10px 6px; margin-bottom: 8px; background-color: rgb(21,40,54); }
Button.social-person-name { white-space: normal; -unity-text-align: middle-left; background-color: rgba(0,0,0,0); border-width: 0; margin-left: 0; color: rgb(217,232,236); }
.social-offline { align-items: center; justify-content: center; flex-grow: 1; }
.social-offline Button { margin-top: 24px; }
.compact-front-end .social-page { margin: 22px 38px; }
.compact-front-end .social-heading { margin-bottom: 10px; }
.compact-front-end .profile-metrics { padding: 10px 18px; margin-bottom: 12px; }
.compact-front-end .profile-number { font-size: 29px; }
.compact-front-end .profile-portrait { width: 58px; height: 58px; }
.compact-front-end Button.profile-hero { padding: 10px; }
.compact-front-end .profile-match { min-height: 48px; }
.home-topbar #home-friends { margin-right: 20px; }
.network-member { flex-direction: row; align-items: center; }
Button.lobby-bot-control { font-size: 12px; min-height: 28px; padding: 4px 8px; margin-left: 8px; border-radius: 2px; color: rgb(37,65,76); background-color: rgb(218,230,224); }
.lobby-countdown { position: absolute; left: 36%; right: 36%; top: 28%; padding: 28px; align-items: center; background-color: rgba(9,25,38,.96); border-width: 1px; border-color: rgb(67,104,120); }
.lobby-countdown-number { font-size: 88px; color: rgb(255,205,117); -unity-font-definition: url("ChineseBold.asset"); }
.lobby-countdown-copy { font-size: 16px; color: rgb(219,231,235); margin-bottom: 12px; white-space: normal; }
.steam-login { margin-top: 16px; }
.connection-tabs Button.route-button { min-width: 0; flex-grow: 1; flex-basis: 0; }

/* Room browser and room-code/password dialogs. */
.network-setup { width: 860px; }
.network-setup .connection-tabs { margin-bottom: 12px; }
.network-setup .connection-tabs Button { flex-grow: 1; margin-right: 6px; }
.network-setup .network-scroll { height: 300px; }
.join-dialog { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(13,31,41,.84); border-radius: 20px; }
.join-dialog-card { width: 88%; max-width: 520px; background-color: rgb(242,246,235); padding: 20px; }
.room-list-info { flex-grow: 1; flex-shrink: 1; min-width: 0; padding: 4px 8px; }
.discovery-room .room-list-title { font-size: 18px; margin-bottom: 4px; }
.room-lock { width: 20px; height: 24px; flex-shrink: 0; margin: 0 6px; }
.room-lock-shackle { position: absolute; left: 4px; top: 1px; width: 12px; height: 14px; border-width: 3px; border-color: rgb(157,117,45); border-radius: 8px; }
.room-lock-body { position: absolute; left: 1px; top: 10px; width: 18px; height: 13px; background-color: rgb(201,151,60); border-radius: 3px; }
.network-setup .connection-tabs { background-color: rgb(222,231,225); border-color: rgb(192,207,201); border-radius: 8px; }
.network-setup .connection-tabs Button.route-button { color: rgb(44,74,80); background-color: rgba(0,0,0,0); border-width: 0; border-radius: 6px; padding: 8px; }
.network-setup .connection-tabs Button.route-button.route-selected { color: rgb(250,244,217); background-color: rgb(44,108,108); }
.network-setup .connection-tabs Button.route-button:disabled { color: rgb(141,155,153); }
.ai-difficulty-panel { margin-top: 20px; padding: 14px 20px; background-color: rgba(10,27,37,0.88); border-radius: 8px; }
.ai-difficulty-panel .unity-base-field { max-width: 330px; font-size: 18px; }
.ai-difficulty-panel .muted { font-size: 14px; white-space: normal; margin-top: 6px; }
.tactics-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.signal-wheel { position: absolute; width: 300px; height: 300px; }
.signal-choice { position: absolute; width: 102px; height: 36px; margin: 0; font-size: 17px; color: rgb(219,233,232); -unity-text-align: middle-center; -unity-font-definition: url("ChineseBold.asset"); }
.signal-selected { color: rgb(255,230,153); font-size: 19px; }
.signal-center { position: absolute; left: 105px; top: 120px; width: 90px; height: 60px; margin: 0; font-size: 12px; color: rgb(210,222,216); -unity-text-align: middle-center; }
.observation-status { position: absolute; left: 22px; bottom: 192px; margin: 0; padding: 5px 9px; border-radius: 5px; background-color: rgba(9,26,34,0.78); color: rgb(204,232,221); font-size: 12px; }
.observation-groups { position: absolute; left: 22px; bottom: 170px; margin: 0; padding: 3px 8px; background-color: rgba(9,26,34,0.72); border-radius: 4px; color: rgb(174,198,191); font-size: 10px; }
.world-signal { position: absolute; width: 144px; min-height: 30px; margin: 0; padding: 6px 8px; border-radius: 6px; background-color: rgba(8,24,32,0.93); border-width: 1px; border-color: rgba(171,208,194,0.6); font-size: 14px; -unity-text-align: middle-center; -unity-font-definition: url("ChineseBold.asset"); }
.minimap-signal { position: absolute; width: 26px; height: 26px; margin: 0; border-radius: 15px; border-width: 2px; border-color: rgba(255,233,153,0.9); background-color: rgba(9,25,34,0.96); font-size: 13px; -unity-text-align: middle-center; -unity-font-definition: url("ChineseBold.asset"); }

.signal-center { background-color: rgba(9,26,34,0.96); border-radius: 36px; border-width: 1px; border-color: rgba(132,178,160,0.65); }

.party-entry { margin-top: 6px; align-self: flex-start; min-height: 40px; padding: 8px 18px; background-color: rgba(25,65,68,0.94); color: rgb(216,243,231); border-width: 1px; border-color: rgba(126,200,176,0.6); font-size: 16px; }
.friends-tabs { margin-bottom: 16px; align-items: center; }
.friends-tabs Button { margin-right: 12px; }
.friends-tabs Label { margin-left: 14px; }
.party-body { flex-grow: 1; }
.party-columns { flex-direction: row; }
.party-main { width: 62%; padding-right: 22px; }
.party-side { width: 38%; padding-left: 18px; border-left-width: 1px; border-left-color: rgba(149,190,177,0.25); }
.party-member { flex-direction: row; align-items: center; min-height: 70px; padding: 10px 16px; margin: 0 0 8px; background-color: rgba(13,35,44,0.90); border-radius: 6px; }
.party-member Label { flex-grow: 1; font-size: 17px; white-space: normal; color: rgb(218,237,230); }
.party-member Button { font-size: 13px; margin-left: 8px; padding: 7px; }
.party-actions { flex-wrap: wrap; margin-top: 10px; }
.party-actions Button { margin-right: 8px; margin-bottom: 7px; min-width: 95px; }
.party-invites { min-height: 90px; max-height: 300px; }
.party-invite { padding: 10px; margin-bottom: 8px; background-color: rgba(16,40,48,0.95); border-radius: 5px; }
.party-invite Label { white-space: normal; font-size: 15px; color: rgb(219,233,221); }
.party-invite Button { margin-top: 6px; }
.party-room { margin-top: 14px; padding: 14px; background-color: rgba(13,35,44,0.90); border-radius: 6px; }
.party-room-slot { padding: 5px; font-size: 15px; color: rgb(212,232,222); }
.chat-toggle { position: absolute; left: 22px; bottom: 18px; padding: 7px 14px; color: rgb(202,230,221); font-size: 13px; background-color: rgba(10,28,37,0.9); border-radius: 5px; }
.chat-toggle.chat-in-match { left: auto; right: 22px; }
.chat-panel { position: absolute; left: 18px; bottom: 54px; width: 380px; max-width: 88%; height: 320px; max-height: 65%; padding: 12px; background-color: rgba(7,22,31,0.96); border-width: 1px; border-color: rgba(115,176,156,0.7); border-radius: 8px; }
.chat-panel .unity-base-field { margin: 0; font-size: 14px; }
.chat-panel Button { font-size: 14px; padding: 6px 10px; margin-left: 6px; }
.chat-messages { flex-grow: 1; margin: 9px 0 6px; }
.chat-message { white-space: normal; margin-bottom: 7px; font-size: 14px; color: rgb(215,231,222); }
.chat-status { font-size: 11px; color: rgb(237,187,133); white-space: normal; }
.compact-front-end .party-page { padding: 24px 36px; }
.compact-front-end .party-member { min-height: 56px; }
.compact-front-end .party-actions Button { font-size: 13px; min-width: 75px; }

.community-login-dialog { position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: center; align-items: center; background-color: rgba(4,13,19,0.85); }
.community-login-card { width: 460px; max-width: 90%; padding: 28px; background-color: rgb(14,34,44); border-radius: 10px; border-width: 1px; border-color: rgb(80,131,119); }
.community-login-card Label { white-space: normal; font-size: 16px; margin-bottom: 12px; color: rgb(211,233,224); }
.community-login-card Button { min-height: 36px; margin-top: 8px; }
.community-login-card .unity-base-field { margin-bottom: 10px; }
.community-login-card TextField > .unity-base-field__input, .party-page TextField > .unity-base-field__input { background-color: rgb(8,22,31); border-width: 1px; border-color: rgb(102,145,153); border-radius: 4px; min-height: 34px; padding: 5px 9px; color: rgb(245,249,247); -unity-selection-color: rgb(47,105,119); -unity-cursor-color: rgb(255,213,120); }
.community-login-card TextField .unity-text-element, .party-page TextField .unity-text-element { color: rgb(245,249,247); }
.community-login-card TextField:focus > .unity-base-field__input { border-color: rgb(255,213,120); }
.party-page Button { color: rgb(22,41,52); background-color: rgb(222,232,227); opacity: 1; transition-duration: 0s; }
.party-page Button.primary { background-color: rgb(247,196,91); }
.party-page Button:hover { background-color: rgb(255,245,218); }
.party-page Button:disabled { color: rgb(218,229,234); background-color: rgb(50,68,80); border-color: rgb(102,123,135); opacity: 1; }
.draft-slots { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
Button.draft-point { font-size: 11px; min-height: 28px; margin: 2px 4px 2px 0; padding: 4px 7px; border-radius: 3px; border-width: 1px; }
Button.draft-point-selected { background-color: rgb(255,201,108); border-color: rgb(255,228,166); }
.selection-ability { padding: 0; align-items: stretch; }
Button.selection-ability-toggle { background-color: rgba(26,45,60,0); border-width: 0; border-radius: 2px; padding: 12px 10px; margin: 0; min-height: 72px; color: rgb(220,234,240); -unity-text-align: middle-left; }
Button.selection-ability-toggle:hover { background-color: rgba(99,137,153,0.18); }
.selection-ability .parameter-copy { padding: 10px 12px; margin: 0; border-top-width: 1px; border-top-color: rgb(61,88,103); white-space: normal; font-size: 13px; color: rgb(208,227,235); }
.skill-expand { color: rgb(255,209,124); font-size: 20px; margin-left: 8px; }
.selection-base-stats { white-space: normal; color: rgb(176,197,210); font-size: 12px; margin-top: 8px; }

.friends-tabs { flex-wrap: wrap; }
.friends-tabs .social-muted { flex-shrink: 1; font-size: 13px; white-space: normal; }

.chat-panel Button { background-color: rgb(24,55,65); color: rgb(218,238,229); border-width: 1px; border-color: rgb(61,105,104); border-radius: 4px; }
.chat-panel .unity-base-field__input { background-color: rgb(21,44,54); color: rgb(225,240,232); }
.chat-panel .unity-text-field__input { color: rgb(225,240,232); }
.chat-panel .unity-popup-field__text { color: rgb(225,240,232); }
